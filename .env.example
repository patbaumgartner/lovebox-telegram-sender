# Copy to .env next to docker-compose.yml and fill in your own values.

# ── Lovebox account ──────────────────────────────────────────────────────────
# Set to false for a dry run that renders and echoes images but never calls the
# Lovebox API.
LOVEBOX_ENABLED=true
LOVEBOX_EMAIL="me@example.com"
LOVEBOX_PASSWORD="mySecret"

# ── Lovebox device & box (see README: "Obtaining your Lovebox IDs") ──────────
LOVEBOX_SIGNATURE="Signature"
LOVEBOX_DEVICE_ID="42fab8322d8cec91"
LOVEBOX_BOX_ID="417a114e58e15a0214cf3612"

# ── Telegram bot (see README: "Setting up a Telegram Bot") ───────────────────
BOT_USERNAME="Lovebox_bot"
BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
# Mandatory. Comma-separated Telegram chat ids that may use the bot; every other
# chat is refused. Message the bot once and it replies with the id to put here.
BOT_ALLOWED_CHAT_IDS="123456789"
# SENDER      - echo the image back only to whoever sent it (default)
# ALL_ALLOWED - echo to every chat above, so a couple sharing one box sees
#               each other's notes and their delivery status
BOT_ECHO_MODE="SENDER"

# ── Container ────────────────────────────────────────────────────────────────
# Timezone for the "Executed" caption timestamp and the offset sent to Lovebox.
TZ="Europe/Zurich"
